   closepath fill
grestore

% TEXT
newpath
0 setgray
   gsave
      1 setlinewidth
      170 860 moveto
      gsave
        gsave
        0
            /Helvetica findfont [20 0 0 -20 0 0] makefont setfont
            (save output) TGSW 
        add
        grestore
      2 div neg 0 rmoveto
            0 setgray
            /Helvetica findfont [20 0 0 -20 0 0] makefont setfont
            (save output) show
      grestore
      0 22 rmoveto
      gsave
        gsave
        0
            /Helvetica findfont [20 0 0 -20 0 0] makefont setfont
            (data and ) TGSW 
        add
        grestore
      2 div neg 0 rmoveto
            0 setgray
            /Helvetica findfont [20 0 0 -20 0 0] makefont setfont
            (data and ) show
      grestore
      0 22 rmoveto
      gsave
        gsave
        0
            /Helvetica findfont [20 0 0 -20 0 0] makefont setfont
            (modify input) TGSW 
        add
        grestore
      2 div neg 0 rmoveto
            0 setgray
            /Helvetica findfont [20 0 0 -20 0 0] makefont setfont
            (modify input) show
      grestore
      0 22 rmoveto
      gsave
        gsave
        0
            /Helvetica findfont [20 0 0 -20 0 0] makefont setfont
            (data) TGSW 
        add
        grestore
      2 div neg 0 rmoveto
            0 setgray
            /Helvetica findfont [20 0 0 -20 0 0] makefont setfont
            (data) show
      grestore
   grestore

