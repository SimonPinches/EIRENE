@Article{kn:Takizuka,
  author   = {Tomonor Takizuka and Hirotada Abe},
  title    = {A binary collision model for plasma simulation with a particle code},
  journal  = {Journal of Computational Physics},
  year     = {1977},
  volume   = {25},
  number   = {3},
  pages    = {205--219},
  issn     = {0021-9991},
