@TechReport{kn:Behringer,
  author      = {Behringer, T.},
  title       = {{E}influ{\ss} nichtlinearer {E}ffekte auf den {N}eutralgastransport in {T}okamaks},
  institution = {Forschungszentrum J{\"u}lich},
  year        = {1992},
  number      = {Juel-2637},
  address     = {J\"ulich},
  abstract    = {Der lineare Monte Carlo Code EIRENE zur Beschreibung des Neutralgasverhaltens in Plasmen und im Gebiet der freien Molekularstr\"omung wurde auf das nichtlineare \"Ubergangsgebiet  (gekennzeichnet durch Knudsen-Zahlen $\textit{Kn}$ von 0.1. bis 10) erweitert. Motivation daf\"ur war, da{\ss} mit zunehmender Gr\"o{\ss}e fusionsorientierter Tokamakexperimente die  Neutralgasdichten in der Plasma-Randschicht und in den Bauteilen des Vakuumsystems Werte von einigen 10$^{13}$cm$^{-3}$ bis 10$^{15}$cm$^{-3}$ erreichen und dabei einerseits  der Bereich der freien Molekularstr\"omung verlassen wird, andererseits der G\"ultigkeitsbereich der Kontinuumstheorie noch nicht erreicht ist. Deswegen m\"ussen kinetische Berechnungsverfahren eingesetzt werden, wobei hier das Verfahren der 'Monte Carlo Direkt-Simulation' nach Bird gew\"ahlt wurde. Das so erweiterte Programm wurde dann auf die Untersuchung wichtiger Fragestellungen in Fusionsexperimenten angewendet. Dabei stand die Bestimmung von Str\"omungs-Leitwerten im Vordergrund. Bei den Str\"omungen ohne Plasmahintergrund ergab sich f\"ur die untersuchten kurzen zylindrischen Rohre und Kr\"ummer ausnahmslos ein monotoner Anstieg der Leitwerte mit abnehmender Knudsen-Zahl. Vergleiche mit experimentell ermittelten Werten zeigten gute \"Ubereinstimmung. Die Untersuchung von \"Ubergangsstr\"omungen mit Plasmahintergrund beschr\"ankte sich auf die Angabe von Unterschieden zu den entsprechenden linearen Rechnungen, wobei der Plasmahintergrund in seinen Eigenschaften w\"ahrend der Simulationen jeweils unver\"andert blieb. Beim eindimensionalen Plasmaschicht-Modell mit Bezug zum Konzept des sog. 'Gastarget-Divertors' ergaben sich ma{\ss}gebliche \"Anderungen in den Dichteprofilen und in den Profilen f\"ur die mittleren Energien der Neutralteilchen. Es stellte sich au{\ss}erdem heraus, dass inelastische Neutral-Neutral-Prozesse hierbei vernachl\"assigt werden k\"onnen. Bei den untersuchten Pumplimitergeometrien, mit Bezug auf Experimente am Tokamak TEXTOR, erh\"ohten sich mit zunehmender Teilchenquellflu{\ss}dichte im Einlaufkanal die Leitwerte in Richtung Pumpe um bis zu 25\%. Eine bereits vorliegende, auf Experimenten basierende Sch\"atzung des Einflusses nichtlinearer Neutralgaseffekte auf die Leitwerte konnte best\"atigt werden. Als Ergebnis der vorliegenden Arbeit liegt ein Rechenprogramm vor, mit dem das Neutralgasverhalten in Bauteilen beliebiger 3-dimensionaler Formgebung nun auch f\"ur h\"ohere Dichten korrekt berechenbar ist und mit dem bei Kopplung mit einem Plasma-Code eine konsistente L\"osung von Problemen der Neutralgas-Plasma-Wechselwirkung m\"oglich wird.},
  cid         = {I:(DE-Juel1)PRE2000-20140101},
  cin         = {PRE-2000},
  pages       = {II, 115 p.},
  pid         = {G:(DE-HGF)POF3-899},
  pnm         = {899 - ohne Topic (POF3-899)},
  publisher   = {Forschungszentrum J\"ulich GmbH Zentralbibliothek, Verlag},
  reportid    = {FZJ-2018-03849, Juel-2637},
  series      = {Berichte des Forschungszentrums J\"ulich},
  typ         = {PUB:(DE-HGF)3 / PUB:(DE-HGF)29},
  url         = {http://hdl.handle.net/2128/19181},
  volume      = {2637},
}

