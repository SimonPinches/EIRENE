# Ignore non-src folders
bin*
build*
doc*
lib*


# backup files
*.bak
*.orig

# Ignore temporary files
*~

# local files and directories
local/
*.local
*.local/

# object, archive,... files
*.[oa]
*.mod

# error messages from compiler etc.
*.error

# files produced by the Makefile
TAGS

# Ignore eclipse files
.cproject
.project
.metadata
.settings

# Ignore PDF in Manual
Manual/*.pdf
Manual/*.dvi
Manual/*.cfg
Manual/*.out.ps

# Ignore EIRENE test cases
EIRENE-sample-cases
