# Test whether necessary variables are set
IRISLIB  ?= /fusion/projects/codes/solps/SOLPS-ITER/public_lib/GA.ifort64
GR_ROOT  ?= ${IRISLIB}
GLI_HOME ?= ${IRISLIB}/gli/src
NAGDIR   ?= ${IRISLIB}
LD_GR    ?= -L${GR_ROOT} -lgr
LD_GKS   ?= -L${GLI_HOME} -lgks -lgfortran
LD_NAG   ?= -L${NAGDIR} -lnag

# DEFINES += -DRECL_UNITS_PER_DOUBLE=8 -DNO_F01AAF -DNO_SAVE

CPP       = -/lib/cpp -traditional

MPI_FC   ?= mpif90
ifdef SOLPS_MPI
 FC       = ${MPI_FC}
 COMPILER_TYPE = $(shell ${MPI_FC} --version | head -1 | cut -d ' ' -f 1)
 ifeq (${COMPILER_TYPE},GNU)
  COMPILER_REDEF = yes
 endif
else
 ifdef USE_IMPGYRO
  FC      = ${MPI_FC}
 endif
 COMPILER_TYPE = $(shell ${MPI_FC} --version | head -1 | cut -d ' ' -f 1)
 ifeq (${COMPILER_TYPE},GNU)
  COMPILER_REDEF = yes
 endif
endif

ifndef COMPILER_REDEF
 ifndef SOLPS_DEBUG
  FCOPTS += -O3
  CFLAGS += -O3
 endif
endif

GKS       = ${LD_GR} ${LD_GKS} -lX11 -lXt

LDLIBS    = -L/usr/local/lib -L/usr/X11R6/lib64 

#!!!Local Variables:
##!!! mode: Makefile
##!!! End:
