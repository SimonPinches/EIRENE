#
# modules/Eirene config.*.* for IPP.CR Prague servers
#   - based on config.default.gfortran
#

# Test whether necessary variables are set

CPP       = /lib/cpp -traditional

#
# Re-define FC for mpi compilation
#

MPI_FC   ?= mpif90
ifdef SOLPS_MPI
FC        = ${MPI_FC}
else
ifdef USE_IMPGYRO
FC        = ${MPI_FC}
endif
endif

FCOPTS    = -fno-second-underscore
ifdef SOLPS_DEBUG
FCOPTS   += -ffpe-trap=denormal -fsignaling-nans
endif

ifdef LD_GR
ifdef LD_GKS
ifdef GLI_HOME
GKS       = ${LD_GR} ${LD_GKS} -lX11 -lXt
endif
endif
endif

LDLIBS    = -L/usr/local/lib -L/usr/X11R6/lib

INCMOD    = -B

COMPILE   = ${FC} -c ${FCOPTS} ${INCMOD}${OBJDIR}

#!!!Local Variables:
#!!! mode: Makefile
#!!! End:
