# Test whether necessary variables are set
GLI_HOME  ?= /pfs/work/g2dpc/SOLPS-ITER/gks
GR_ROOT   ?= /pfs/work/g2dpc/SOLPS-ITER/gr
LD_GR     ?= -L${GR_ROOT} -lgr
LD_GKS    ?= -L${GLI_HOME} -lgks -lgfortran

# DEFINES += -DRECL_UNITS_PER_DOUBLE=8 -DNO_F01AAF -DNO_SAVE

CPP     = -/lib/cpp -C -traditional -ffreestanding

MPI_FC ?= mpiifort
ifdef SOLPS_MPI
 FC     = ${MPI_FC}
else
 ifdef USE_IMPGYRO
  FC    = ${MPI_FC}
 endif
endif

FCOPTS  = -assume no2underscore -fPIC
ifndef SOLPS_DEBUG
FCOPTS += -O3 -xHost
CFLAGS  = -O3
endif

GKS     = ${LD_GR} ${LD_GKS} -lX11 -lXt -lxcb

LDLIBS  = -L/usr/local/lib


#!!!Local Variables:
#!!! mode: Makefile
#!!! End:

