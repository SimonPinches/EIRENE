${OBJDIR}/%.o : %.f
	-${CPP} ${DEFINES} ${EQUIVS} -P ${INCLUDE} $< ${OBJDIR}/$*.f
	${FC} ${FCOPTS} ${FFLAGSEXTRA} -c ${INCLUDE} ${INCMOD}${OBJDIR} ${OBJDEST} ${OBJDIR}/$*.f
ifneq ($(COMPILER),nag_f90)
	@if [ -f ${OBJDIR}/$*.${MOD} ] ; then touch ${OBJDIR}/$*.${MOD} ; fi
endif

