C V. KOTOV, 13.02.2005
C
C THIS MODULE CONTAINS FUNCTION FOR BACKWARD APPROXIMATION OF SOURCES
C IN THIS VERSION THE FOLLOWING FEATURES AVAILABLE:
C  APPROXIMATION WITH 2 FREE PARAMETERS
C  AUTOMATIC CHOICE OF THE BEST (WITH MINIMUM DISPERSION) APPROXIMATION FROM
C  THE SET  A+B*t^n (n=1..3)
C  DATA STORAGE AND ASSIGNMENT FOR HYDROGEN RECOMBINATION PARTICLE AND ENERGY SO
C  TABRC1(1,:), EELRC1(1,:)
C

      MODULE EIRMOD_CAPRMC

      USE EIRMOD_PRECISION
      USE EIRMOD_PARMMOD
      USE EIRMOD_CGRID
      USE EIRMOD_COMXS
      USE EIRMOD_COMUSR
      USE EIRMOD_CTRCEI
      USE EIRMOD_CCOUPL
      USE EIRMOD_COMSOU
      USE EIRMOD_COMPRT !VKMPI

      IMPLICIT NONE

      PUBLIC :: EIRENE_INIT_CAPRMC, 
     p          EIRENE_DEALLOC_CAPRMC, EIRENE_ALLOC_CAPRMC,
     p          INIT_RECOMB_CORRECTION, APRMC_RECOMB_CORRECTION,
     p          INIT_PLASMA_CORRECTION, APRMC_PLASMA_CORRECTION,
     p          INIT_SOURCES_CORRECTION, APRMC_SOURCES_CORRECTION,
     p          READ_PLASMA_CORRECTION
c     p          CALC_APROXX !ONLY FOR TEST!

      INTEGER,PARAMETER,PUBLIC :: APRMC_OPTION=1 !TYPE OF CORRECTION

      PRIVATE

      INTEGER,PARAMETER :: NOPT=2, !NUMBER OF OPTIONS AVAILABLE
     p                     NAP=6, !NUMBER OF POINTS FOR INTERPOLATION, MUST BE >
     p                     NFUN2(NOPT)=(/4,8/), !NUMBER OF USED F(NOPT)UNCTIONS
     p                     NFUN= NFUN2(APRMC_OPTION),
     p                     NASRC=20,   !
     p                     NASTR=7,   !
     p                     NSI2(NOPT)=(/2,NASRC*NASTR/),  !NUMBER OF SOURCES TO
     p                     NSI=NSI2(APRMC_OPTION),
     p                     NAP2=NAP-2, NAP1=NAP-1, DNAP=2*NAP,
     p                     DIAGPOINT2(NOPT)=(/1400,1400/), !CELL FOR DIAGNOSTIC
     p                     DIAGPOINT=DIAGPOINT2(APRMC_OPTION)
      REAL(DP),PARAMETER :: INAP=1._DP/NAP,INAP1=1._DP/NAP1
      REAL(DP) :: APPOW2(8,NOPT),APPOW(NFUN)

      DATA APPOW2 /0.25,0.5,0.75,1.,0.,0.,0.,0.,
     r             0.25,0.5,0.75,1.,1.5,2.,2.5,3./

      REAL(DP),SAVE :: MAXREAL,
     r                 SJ(NFUN),SJ2(NFUN),SI(NFUN,NAP2), !VARIABLES FOR THE FAST
     r                 NNP(NFUN), NAPD(NFUN),            !CALCULATION OF THE INT
     r                 AD(NFUN),BD(NFUN),CD(NFUN)        !COEFFICIENTS FOR CALCU

      REAL(DP),ALLOCATABLE,PUBLIC,SAVE :: XINTOLD(:,:,:),!DATA STORAGE FOR TIME-
     r                                    TEPLS_SAVE(:),PLS_SAVE(:) !PLASMA PARA

      CONTAINS

C
C *********************** SUBROUTINES RELATED TO SPECIFIC SOURCES **************
C
      SUBROUTINE EIRENE_ALLOC_CAPRMC
       SELECT CASE(APRMC_OPTION)
       CASE(1)
         IF(.NOT.ALLOCATED(XINTOLD))
     f     ALLOCATE(XINTOLD(MAX(NSBOX,NRAD),NSI,NAP),
     a              TEPLS_SAVE(MAX(NSBOX,NRAD)),
     a              PLS_SAVE(MAX(NSBOX,NRAD)))
       CASE(2)
        IF(.NOT.ALLOCATED(XINTOLD))
     f     ALLOCATE(XINTOLD((NDXA+2)*(NDYA+2),NSI,NAP))
       END SELECT
      END SUBROUTINE EIRENE_ALLOC_CAPRMC

      SUBROUTINE EIRENE_DEALLOC_CAPRMC
       IF(ALLOCATED(XINTOLD)) DEALLOCATE(XINTOLD)
      END SUBROUTINE EIRENE_DEALLOC_CAPRMC


C
C FILLS OUT THE TIME-HISTORY ARRAYS ON THE FIRST TIME-STEP
C
      SUBROUTINE INIT_SOURCES_CORRECTION(SEE,SEI,SNI,SMO,ISTRA)
      REAL(DP),INTENT(IN) :: SEE(0:NDXA+1,0:NDYA+1,NSTRAI),
     r                       SEI(0:NDXA+1,0:NDYA+1,NSTRAI),
     r                       SNI(0:NDXA+1,0:NDYA+1,NFL,NSTRAI),
     r                       SMO(0:NDXA+1,0:NDYA+1,NFL,NSTRAI)
      INTEGER,INTENT(IN) :: ISTRA
      INTEGER :: IX,IY,IND,IFL
      IF(ISTRA.GT.NASTR) RETURN

      DO IX=0,NDXA+1
        DO IY=0,NDYA+1
          IND=IX*(NDYA+2)+IY+1
          XINTOLD(IND,NASRC*(ISTRA-1)+1,1:NAP)=
     =                        SEE(IX,IY,ISTRA) !ELECTRON ENERGY
c          WRITE(iunout,*) "DBG: ISTRA, IX,IY,IND, SEE(IX,IY,ISTRA)",
c     w                     ISTRA, IX,IY,IND, SEE(IX,IY,ISTRA)
c          WRITE(iunout,*) "DBG: NASRC*(ISTRA-1)+1,XINTOLD",
c     w          NASRC*(ISTRA-1)+1,XINTOLD(IND,NASRC*(ISTRA-1)+1,1:NAP)
          XINTOLD(IND,NASRC*(ISTRA-1)+2,1:NAP)=
     =                        SEI(IX,IY,ISTRA) !ION ENERGY SOURCE
c         WRITE(iunout,*) "DBG: NFLA", NFLA
          DO IFL=1,NFLA
            XINTOLD(IND,NASRC*(ISTRA-1)+2+IFL,1:NAP)=
     =                        SNI(IX,IY,IFL,ISTRA) !PARTICLE
c            WRITE(iunout,*) "DBG: IND, NASRC*(ISTRA-1)+2+IFL,XINTOLD",
c     w                       IND, NASRC*(ISTRA-1)+2+IFL,
c     w                       XINTOLD(IND,NASRC*(ISTRA-1)+2+IFL,1:NAP)
            XINTOLD(IND,NASRC*(ISTRA-1)+2+NFLA+IFL,1:NAP)=
     =                        SMO(IX,IY,IFL,ISTRA) !MOMENTUM
          END DO
        END DO
      END DO
      END SUBROUTINE INIT_SOURCES_CORRECTION

C
C CORRECTION OF HYDROGEN RECOMBINATION SOURCES
C
      SUBROUTINE APRMC_SOURCES_CORRECTION(SEE,SEI,SNI,SMO,ISTRA)
      REAL(DP),INTENT(INOUT) :: SEE(0:NDXA+1,0:NDYA+1,NSTRAI),
     r                       SEI(0:NDXA+1,0:NDYA+1,NSTRAI),
     r                       SNI(0:NDXA+1,0:NDYA+1,NFL,NSTRAI),
     r                       SMO(0:NDXA+1,0:NDYA+1,NFL,NSTRAI)
      INTEGER,INTENT(IN) :: ISTRA
      INTEGER :: IDIAG(NSI),I,IFL,IX,IY,IND
      REAL(DP) :: XX(NAP)
      LOGICAL,SAVE :: IFIRST(NASTR)
      DATA IFIRST /NASTR*.TRUE./

       IF(ISTRA.GT.NASTR) RETURN


       IF(IFIRST(ISTRA)) THEN
         CALL INIT_SOURCES_CORRECTION(SEE,SEI,SNI,SMO,ISTRA)
         IFIRST(ISTRA)=.FALSE.
       END IF

       IF(TRCMOD) THEN
        WRITE(iunout,*) "DBG: APRMC_SOURCES_CORRECTION"
        WRITE(iunout,*) "DBG: BEFORE CORRECTION, ISTRA", ISTRA
        WRITE(iunout,*) "DBG: SEE,SEI",
     w             SUM(SEE(:,:,ISTRA)), SUM(SEI(:,:,ISTRA))
        WRITE(iunout,*) "DBG: SNI", SUM(SNI(:,:,:,ISTRA))
        WRITE(iunout,*) "DBG: SMO", SUM(SMO(:,:,:,ISTRA))
       END IF
        DO IX=0,NDXA+1
          DO IY=0,NDYA+1
           IND=IX*(NDYA+2)+IY+1

           IF(IND.EQ.DIAGPOINT) THEN
            IDIAG(1)=1
            IDIAG(2)=2
           ELSE
            IDIAG=0
           END IF

C SHIFTING OF THE TIME-HISTORY ARRAYS
           DO I=1,NAP1
             XINTOLD(IND,NASRC*(ISTRA-1)+1,I)=
     =                          XINTOLD(IND,NASRC*(ISTRA-1)+1,I+1) !ELECTRON ENERGY
             XINTOLD(IND,NASRC*(ISTRA-1)+2,I)=
     =                          XINTOLD(IND,NASRC*(ISTRA-1)+2,I+1) !ION ENERGY SOURCE
             DO IFL=1,NFLA
               XINTOLD(IND,NASRC*(ISTRA-1)+2+IFL,I)=
     =                 XINTOLD(IND,NASRC*(ISTRA-1)+2+IFL,I+1) !PARTICLE SOURCE
               XINTOLD(IND,NASRC*(ISTRA-1)+2+NFLA+IFL,I)=
     =                 XINTOLD(IND,NASRC*(ISTRA-1)+2+NFLA+IFL,I+1) !MOMENTUM
             END DO
           END DO
C RECENT POINT
           XINTOLD(IND,NASRC*(ISTRA-1)+1,NAP)=SEE(IX,IY,ISTRA) !ELECTRON ENERGY
c           WRITE(iunout,*) "DBG: IND,NASRC*(ISTRA-1)+1,XINTOLD",
c   w          IND,NASRC*(ISTRA-1)+1,XINTOLD(IND,NASRC*(ISTRA-1)+1,1:NAP)
           XINTOLD(IND,NASRC*(ISTRA-1)+2,NAP)=SEI(IX,IY,ISTRA) !ION ENERGY SOURCE
           DO IFL=1,NFLA
             XINTOLD(IND,NASRC*(ISTRA-1)+2+IFL,NAP)=
     =               SNI(IX,IY,IFL,ISTRA) !PARTICLE
             XINTOLD(IND,NASRC*(ISTRA-1)+2+NFLA+IFL,NAP)=
     =               SMO(IX,IY,IFL,ISTRA) !MOMENTUM
           END DO
C SMOOTHING

c            WRITE(iunout,*) "DBG*: IND, NASRC*(ISTRA-1)+1+IFL,XINTOLD",
c     w                       IND, NASRC*(ISTRA-1)+2+IFL,
c     w                       XINTOLD(IND,NASRC*(ISTRA-1)+2+1,1:NAP)
c          WRITE(iunout,*) "DBG:XINTOLD",XINTOLD(IND,NASRC*(ISTRA-1)+1,1:NAP)
           XX=XINTOLD(IND,NASRC*(ISTRA-1)+1,1:NAP)
c           WRITE(iunout,*) "DBG: XX",XX
           SEE(IX,IY,ISTRA)= EIRENE_CALC_APROXX(XX,IDIAG(1)) !ELECTRON ENERGY SOURCES
           XX=XINTOLD(IND,NASRC*(ISTRA-1)+2,1:NAP)
           SEI(IX,IY,ISTRA)= EIRENE_CALC_APROXX(XX,IDIAG(1)) !ION ENERGY SOURCES
c           WRITE(iunout,*) "DBG*: NFLA",NFLA
           DO IFL=1,NFLA
             XX=XINTOLD(IND,NASRC*(ISTRA-1)+2+IFL,1:NAP)
c             WRITE(iunout,*) "DBG: XX*",XX
             SNI(IX,IY,IFL,ISTRA)= EIRENE_CALC_APROXX(XX,IDIAG(1)) !ELECTRON ENERGY SOU
             XX=XINTOLD(IND,NASRC*(ISTRA-1)+2+NFLA+IFL,1:NAP)
             SMO(IX,IY,IFL,ISTRA)= EIRENE_CALC_APROXX(XX,IDIAG(1))  !ION ENERGY SOURCES
           END DO

          END DO
        END DO

       IF(TRCMOD) THEN
        WRITE(iunout,*) "DBG: AFTER CORRECTION, ISTRA",ISTRA
        WRITE(iunout,*) "DBG: SEE,SEI",
     w             SUM(SEE(:,:,ISTRA)), SUM(SEI(:,:,ISTRA))
        WRITE(iunout,*) "DBG: SNI", SUM(SNI(:,:,:,ISTRA))
        WRITE(iunout,*) "DBG: SMO", SUM(SMO(:,:,:,ISTRA))
       END IF
      END SUBROUTINE APRMC_SOURCES_CORRECTION

C
C FILLS OUT THE TIME-HISTORY ARRAYS ON THE FIRST TIME-STEP
C
      SUBROUTINE INIT_RECOMB_CORRECTION
      INTEGER :: I,N
       N=MIN(NSBOX,NRAD)
       DO I=1,NAP
        XINTOLD(1:N,1,I)=TABRC1(1,1:N)*DIIN(1,1:N) !PARTICLE SOURCES
        XINTOLD(1:N,2,I)=EELRC1(1,1:N)*DIIN(1,1:N) !ENERGY SOURCES
       END DO
      END SUBROUTINE INIT_RECOMB_CORRECTION

C
C CORRECTION OF HYDROGEN RECOMBINATION SOURCES
C
      SUBROUTINE APRMC_RECOMB_CORRECTION
       INTEGER :: IT,I,IS,IDIAG(NSI)

       WRITE(iunout,*) "DBG: APRMC_RECOMB_CORRECTION"
       WRITE(iunout,*) "DBG: BEFORE CORRECTION"
       WRITE(iunout,*) "DBG: TABRC1, EELRC1",
     w             SUM(TABRC1(1,:)),SUM(EELRC1(1,:))

       DO IT=1,MIN(NSBOX,NRAD)
        IF(LGVAC(IT,1)) CYCLE

        IF(IT.EQ.DIAGPOINT) THEN
         IDIAG(1)=1
         IDIAG(2)=2
        ELSE
         IDIAG=0
        END IF

C SHIFTING OF THE TIME-HISTORY ARRAYS
        DO IS=1,2
         DO I=1,NAP1
          XINTOLD(IT,IS,I)=XINTOLD(IT,IS,I+1)
         END DO
        END DO
        IF(DIIN(1,IT).GT.0) THEN
          XINTOLD(IT,1,NAP)=TABRC1(1,IT)*DIIN(1,IT) !PARTICLE SOURCES
          XINTOLD(IT,2,NAP)=EELRC1(1,IT)*DIIN(1,IT) !ENERGY SOURCES
C CALCULATION OF CORRECTED VALUES
          TABRC1(1,IT)=EIRENE_CALC_APROXX(XINTOLD(IT,1,:),IDIAG(1))
     /                 /DIIN(1,IT)
          EELRC1(1,IT)=EIRENE_CALC_APROXX(XINTOLD(IT,2,:),IDIAG(2))
     /                 /DIIN(1,IT)
        END IF
       END DO
       IF(TRCMOD) THEN
        WRITE(iunout,*) "DBG: AFTER CORRECTION"
        WRITE(iunout,*) "DBG: TABRC1, EELRC1",
     w              SUM(TABRC1(1,:)),SUM(EELRC1(1,:))
       END IF
      END SUBROUTINE APRMC_RECOMB_CORRECTION

C
C FILLS OUT THE TIME-HISTORY ARRAYS ON THE FIRST TIME-STEP
C
      SUBROUTINE INIT_PLASMA_CORRECTION
      INTEGER :: I,N
       N=MIN(NSBOX,NRAD)
       DO I=1,NAP
        XINTOLD(1:N,1,I)=TEIN(1:N)
        XINTOLD(1:N,2,I)=DEIN(1:N)
       END DO
      END SUBROUTINE INIT_PLASMA_CORRECTION

C
C CORRECTION OF PLASMA PARAMETERS (TE&NE) FOR THE CALCULATION OF RECOMB. SOURCES
C
      SUBROUTINE APRMC_PLASMA_CORRECTION(PLS,TEPLS,NSTRD)
       INTEGER,INTENT(IN) :: NSTRD
       REAL(DP) :: PLS(NSTRD),TEPLS(NSTRD)
       INTEGER :: IT,I,IS,IDIAG(NSI)

       IF(TRCMOD) THEN
        WRITE(iunout,*) "DBG: APRMC_PLASMA_CORRECTION"
        WRITE(iunout,*) "DBG: BEFORE CORRECTION"
        WRITE(iunout,*) "DBG: PLS,TEPLS",
     w             SUM(DEIN),SUM(TEIN)
       END IF

       DO IT=1,MIN(MIN(NSBOX,NRAD),NSTRD)
        IF(LGVAC(IT,1)) THEN
          TEPLS(IT)=TEIN(IT)
          PLS(IT)=DEIN(IT)
          CYCLE
        END IF
        IF(IT.EQ.DIAGPOINT) THEN
         IDIAG(1)=1
         IDIAG(2)=2
        ELSE
         IDIAG=0
        END IF

C SHIFTING OF THE TIME-HISTORY ARRAYS
        DO IS=1,2
         DO I=1,NAP1
          XINTOLD(IT,IS,I)=XINTOLD(IT,IS,I+1)
         END DO
        END DO
        IF(DIIN(1,IT).GT.0) THEN
          XINTOLD(IT,1,NAP)=TEIN(IT) !PARTICLE SOURCES
          XINTOLD(IT,2,NAP)=DEIN(IT) !ENERGY SOURCES
C CALCULATION OF CORRECTED VALUES
          TEPLS_SAVE(IT)=EIRENE_CALC_APROXX(XINTOLD(IT,1,:),IDIAG(1))
          PLS_SAVE(IT)=EIRENE_CALC_APROXX(XINTOLD(IT,2,:),IDIAG(2))
        END IF
       END DO
       IF(TRCMOD) THEN
        WRITE(iunout,*) "DBG: AFTER CORRECTION"
        WRITE(iunout,*) "DBG: PLS, TEPLS",
     w              SUM(PLS),SUM(TEPLS)
       END IF
C THIS IS DONE EXACTLY LIKE IN "PLASMA_DERIVE"
       DO IT=1,MIN(MIN(NSBOX,NRAD),NSTRD)
        TEPLS(IT)=LOG(MAX(TVAC,MIN(TEPLS_SAVE(IT),1.E10_DP)))
        PLS(IT)=LOG(MAX(DVAC,MIN(PLS_SAVE(IT),1.E20_DP)))
       END DO
      END SUBROUTINE APRMC_PLASMA_CORRECTION

C READS SAVED CORRECTED PLASMA BACKGROUND
      SUBROUTINE READ_PLASMA_CORRECTION(PLS,TEPLS,NSTRD)
       INTEGER,INTENT(IN) :: NSTRD
       REAL(DP) :: PLS(NSTRD),TEPLS(NSTRD)

       TEPLS(1:NSTRD)= TEPLS_SAVE(1:NSTRD)
       PLS(1:NSTRD)= PLS_SAVE(1:NSTRD)
      END SUBROUTINE READ_PLASMA_CORRECTION

C
C *********************** GENERAL PURPOSE SUBROUTINES **************************
C

C
C INITIALISATION OF PRE-COMPUTED ARRAYS FOR FAST CALCULATION OF THE FIT COEFFICIE
C
C IF MOD=1 THEN THE FUNCTION CALC_APROXX GIVES APPROXIMATION ON THE CURRENT TIME
C          (LAST ELEMENT OF THE XX ARRAY)
C IF MOD=2 THEN THE FUNCTION CALC_APROXX GIVES EXTRAPOLATION TO THE NEXT TIME-ST
C
      SUBROUTINE EIRENE_INIT_CAPRMC(MOD)
       INTEGER,INTENT(IN) :: MOD
       INTEGER :: I,J,NB
       REAL(DP) :: DEL,IDEL,SJ2D,SJD,SJS,SJ2S,POW2,DINAP

       APPOW(1:NFUN)=APPOW2(1:NFUN,APRMC_OPTION)
       MAXREAL=HUGE(MAXREAL)
c       IF(TRCMOD) THEN
        WRITE(iunout,*) "INITIALISING APPROX MC CORRECTION ",
     w             "NAP,NFUN,NSI", NAP,NFUN,NSI
c       END IF
       IF(MOD.EQ.2) THEN
        NB=NAP  !EXTRAPOLATION FOR THE NEXT TIME-STEP
       ELSE
        NB=NAP1 !INTERPOLATION ON THE CURRENT TIME-STEP (DEFAULT)
       END IF
       DINAP=2*INAP
       DO I=1,NFUN
        NNP(I)=NB**APPOW(I)
C PARAMETERS FOR POWER FUNCTION APPROXIMATIOM
        POW2=2*APPOW(I)
        SJ(I)=1
        SJ2(I)=1
        DO J=2,NAP1
          SJ(I)=SJ(I)+J**APPOW(I)
          SJ2(I)=SJ2(I)+J**POW2
          SI(I,J-1)=J**APPOW(I)
        END DO
C DETERMINANT OF NORMAL EQUATION
        DEL=NAP*SJ2(I)-SJ(I)*SJ(I)
        IDEL=1._DP/DEL
        NAPD(I)=NAP*IDEL
        SJD=SJ(I)
        SJ2D=SJ2(I)
        SJ(I)=SJ(I)*IDEL
        SJ2(I)=SJ2(I)*IDEL
C COEFFICIENTS FOR THE CALCULATION OF DEVIATION
        SJS=SJ(I)*SJ(I)
        SJ2S=SJ2(I)*SJ2(I)
        AD(I)=(NAP*SJ2S+SJS*SJ2D-2*SJ2(I)*(1+SJ(I)*SJD))*INAP
        BD(I)=(SJS*DEL+NAPD(I)*SJ2D-2*(1+SJ(I)*SJD))*IDEL
        CD(I)=DINAP*(SJ(I)*(2-NAP*SJ2(I)-NAPD(I)*SJ2D)
     +        +NAPD(I)*SJ2(I)*SJD+SJS*SJD)
        IF(TRCMOD) THEN
         WRITE(iunout,*) "IFUN, DEl, SJ, SJ2",I,DEL,SJD,SJ2D
         WRITE(iunout,*) "AD, BD, CD", AD(I), BD(I), CD(I)
         WRITE(iunout,*) "SI", SI(I,:)
        END IF
       END DO
      END SUBROUTINE EIRENE_INIT_CAPRMC

C
C THIS FUNCTION CALCULATES INTERPOLATED VALUE, CORRESPONDING TO THE LAST ELEMENT
C OR EXTRAPOLATION ON THE NEXT TIME-STEP, DEPENDING FROM PARAMETER MOD (SEE. INIT
C IT CALCULATES FIT COEFFICIENTS FOR THE FORMULA A+B*t^n FOR SEVERAL n USING MEA
C APPROXIMATION OF THE ARRAY XX, AND CHOOSES ONE WITH THE SMALLEST MEAN-SQUARE DE
C IF(IDIAG.GT.0) THE FUNCTION PRINTS OUT DIAGNOSTICS
C
      FUNCTION EIRENE_CALC_APROXX(XX,IDIAG)
       REAL(DP) :: EIRENE_CALC_APROXX
       REAL(DP),INTENT(IN) :: XX(NAP)
       INTEGER, INTENT(IN) :: IDIAG
       INTEGER :: I,J
       REAL(DP) :: SX,SX2,SIX,SXS,A,B,D,DR,XAPR,XAPROPT,DMIN

       SX=SUM(XX)
       SX2=SUM(XX*XX)
       SXS=SX*SX
       DMIN=MAXREAL

c       WRITE(iunout,*) "DBG: XX",XX

       IF(IDIAG.GT.0.AND.TRCMOD)
     f     WRITE(iunout,*) "DIAGNOSTIC FOR APPROX. MC CORRECTIION ",
     w                " DIAGPOINT, ARRAY, X, SX, SX2 ",
     w                 DIAGPOINT, IDIAG, XX(NAP), SX, SX2

       DO I=1,NFUN !LOOP OVER THE EXPONENT n IN THE FORMULA A+B*t^n
C WEIGHTED SUM SIX FOR THE APPROXIMATION BY POWER FUNCTIONS
        SIX=XX(2)
        DO J=3,NAP
         SIX=SIX+SI(I,J-2)*XX(J)
        END DO
C APPROXIMATED VALUE OF X
        A=SJ2(I)*SX-SJ(I)*SIX
        B=NAPD(I)*SIX-SJ(I)*SX
        XAPR=A+B*NNP(I)
C MEAN SQUARE DEVIATION
        D=AD(I)*SXS+BD(I)*SIX*SIX+CD(I)*SIX*SX

        IF(IDIAG.GT.0.AND.TRCMOD) THEN
          D=SQRT(ABS(D+SX2*INAP))
          IF(XX(NAP).NE.0._DP) DR=D/XX(NAP)
          WRITE(iunout,*) "SIX,A,B,XAPR,D, DR", SIX,A,B,XAPR,D,DR
        END IF
C LOOK FOR THE SMALLEST DEVIATION
c        WRITE(iunout,*) "DBG:D,DMIN,XAPR",D,DMIN,XAPR
        IF(ABS(D).LT.DMIN) THEN
         DMIN=ABS(D)
         XAPROPT=XAPR
        END IF
       END DO

       IF(IDIAG.GT.0.AND.TRCMOD) THEN
         IF(XX(NAP).NE.0._DP) DR=DMIN/XX(NAP)
         WRITE(iunout,*) "XAPROPT, DMIN, DMIN_R", XAPROPT, DMIN, DR
       END IF

       EIRENE_CALC_APROXX=XAPR

      END FUNCTION EIRENE_CALC_APROXX

      END MODULE EIRMOD_CAPRMC
