C
C
C
      MODULE EIRMOD_CCFLUX

      USE EIRMOD_PRECISION 
      USE EIRMOD_PARMMOD
      USE EIRMOD_CTRIG
      USE EIRMOD_CGRID
      USE EIRMOD_CCONA
      USE EIRMOD_COMUSR
      USE EIRMOD_CGEOM
      USE EIRMOD_CTRCEI
      USE EIRMOD_COMPRT

      IMPLICIT NONE 

      PRIVATE      
 
      PUBLIC :: EIRENE_INIT_FLUXUPDATE, EIRENE_DEALLOC_FLUXUPDATE,
     p          EIRENE_UPDTFLUX,
     p          EIRENE_INIT_RESCALING, EIRENE_FLUX_RESCALING,
     p          EIRENE_FLUX_RESIDUALS,
     p          EIRENE_SUM_FLUX, EIRENE_INIT_SUM_FLUX,
     p          EIRENE_UPDATE_FLUXCL, EIRENE_SCALE_FLUXES,
     p          SWCH_FLUX_OFF

      LOGICAL :: NOFLUXUPDT
      REAL(DP),ALLOCATABLE,PUBLIC :: ALPHAKK(:,:),FLUXCL_SUM(:,:)
      INTEGER,ALLOCATABLE  :: BCELLS(:,:),BSIDES(:,:) 
      REAL(DP),ALLOCATABLE :: CELL_FLUXES(:,:,:),CELL_FLUXES_SUM(:,:,:),
     r                        NET_SINK(:,:),FLUXCL(:,:)
      INTEGER  :: NEMAX,NFRSPC,NFRCLL
      SAVE

      CONTAINS

      SUBROUTINE EIRENE_INIT_FLUXUPDATE()
    
      INTEGER :: I,J

      CALL SWCH_FLUX_OFF !!!!!!TENTATIVE!!!!!!
      if (.true.) RETURN
 
C TRIANGULAR GRID      
      IF(LEVGEO.EQ.4) THEN 
       NEMAX=3
       NFRSPC=NPHOT !NOW RESCALING IS ONLY FOR PHOTOINS
       NFRCLL=NTRII
       IF(.NOT.ALLOCATED(BCELLS)) 
     f   ALLOCATE(BCELLS(NEMAX,NFRCLL),BSIDES(NEMAX,NFRCLL), 
     a            CELL_FLUXES(NEMAX+1,NFRCLL,NFRSPC), 
     a            CELL_FLUXES_SUM(NEMAX+1,NFRCLL,NFRSPC),
     a            NET_SINK(NFRCLL,NFRSPC),
     a            ALPHAKK(NFRSPC,NFRCLL),
     a            FLUXCL(NFRCLL,NFRSPC),FLUXCL_SUM(NFRCLL,NFRSPC))
C NEIGHBOURING CELLS AND CORRESPONDING SIDES
         DO J=1,NFRCLL
           DO I=1,NEMAX
             BCELLS(I,J)=NCHBAR(I,J)
             BSIDES(I,J)=NSEITE(I,J)
           END DO
c           WRITE(iunout,*) "DBG:",J, BCELLS(:,J),BSIDES(:,J)        
         END DO
         WRITE(iunout,*) "FLUX UPDATE FOR PHOTONS IS SWITCHED ON, ",
     w              "NOFLUXUPDT, NEMAX, NFRSPC, NFRCLL ",
     w               NOFLUXUPDT, NEMAX, NFRSPC, NFRCLL 
      ELSE
        NOFLUXUPDT=.TRUE.
        WRITE(iunout,*) "FLUX UPDATE FOR PHOTONS IS AVAILABLE NOW ",
     w             "ONLY FOR LEVGEO=4",
     w             "FLUX UPDATE IS OFF, LEVGEO,NOFLUXUPDT",
     w             LEVGEO, NOFLUXUPDT
      END IF
      
      END SUBROUTINE EIRENE_INIT_FLUXUPDATE



      SUBROUTINE SWCH_FLUX_OFF()

      NOFLUXUPDT=.TRUE.

      END SUBROUTINE SWCH_FLUX_OFF



      SUBROUTINE EIRENE_DEALLOC_FLUXUPDATE()

       IF(ALLOCATED(BCELLS))
     f   DEALLOCATE(BCELLS,BSIDES,CELL_FLUXES,CELL_FLUXES_SUM,
     d              NET_SINK,ALPHAKK,FLUXCL,FLUXCL_SUM)
 
      END SUBROUTINE EIRENE_DEALLOC_FLUXUPDATE

      SUBROUTINE EIRENE_UPDTFLUX(IRD_OLD,IRD,ISPZ,ITYP,WEIGHT)
      INTEGER,INTENT(INOUT) :: IRD_OLD,IRD,ITYP
      INTEGER,INTENT(IN) :: ISPZ
      REAL(DP),INTENT(IN) :: WEIGHT
      INTEGER :: I,K

      IF(NOFLUXUPDT.OR.IRD_OLD.EQ.IRD) RETURN

      IF(ITYP.NE.0) RETURN !ONLY FOR PHOTONS NOW

      IF(IRD_OLD.GT.0) IRD_OLD=NCLTAL(IRD_OLD)
      IF(IRD.GT.0) IRD=NCLTAL(IRD)

      K=0  
      DO I=1,NEMAX
c       WRITE(0,*) "DBG: UPDTFLUX,IRD_OLD,IRD,ISPZ,WEIGHT,BCELLS)",
c     w                  IRD_OLD,IRD,ISPZ,WEIGHT,BCELLS(:,IRD_OLD)
       IF(BCELLS(I,IRD_OLD).EQ.IRD) THEN
        K=1
        CELL_FLUXES(I,IRD_OLD,ISPZ)=CELL_FLUXES(I,IRD_OLD,ISPZ)+WEIGHT
        EXIT 
       END IF
      END DO   
      IF(K.LT.1) THEN
       IF(IRD.EQ.0) THEN
        IF(TRCMOD)
     f  WRITE(iunout,*) "WARNING FROM UPDTFLUX: THIS CELL ",
     w             "DOES NOT ENCOUNTER EXTERNAL BOUNDARY", 
     w             "IRD_OLD,IRD,BCELLS",
     w              IRD_OLD,IRD,BCELLS(:,IRD_OLD)
        WRITE(iunout,*) "THE INTERSECTION IS SAVED AS A SINK"
        CELL_FLUXES(NEMAX+1,IRD_OLD,ISPZ)=
     =              CELL_FLUXES(NEMAX+1,IRD_OLD,ISPZ)+WEIGHT
       ELSE 
        WRITE(iunout,*) 
     w        "WARNING FROM UPDTFLUX: NO NEIGHBOURING CELLS FOUND",
     w        " IRD_OLD,IRD,BCELLS",
     w        IRD_OLD,IRD,BCELLS(:,IRD_OLD)
       END IF
      END IF 
      END SUBROUTINE EIRENE_UPDTFLUX

  
      SUBROUTINE EIRENE_UPDATE_FLUXCL(IT,ISPZ,WEIGHT)
      INTEGER,INTENT(IN) :: IT,ISPZ
      REAL(DP),INTENT(IN) :: WEIGHT

      IF(NOFLUXUPDT.OR.(.NOT.TRCMOD)) RETURN

c     WRITE(iunout,*) "DBG:UPDATE_FLUXCL:IT,ISPZ,WEIGHT ",IT,ISPZ,WEIGHT
      FLUXCL(IT,ISPZ)=FLUXCL(IT,ISPZ)+WEIGHT 
       
      END SUBROUTINE EIRENE_UPDATE_FLUXCL 

      SUBROUTINE EIRENE_SUM_FLUX(FLXFAC)

      REAL(DP),INTENT(IN) :: FLXFAC

      INTEGER :: I,J
      REAL(DP) :: FSUM

      IF(NOFLUXUPDT) RETURN

      WRITE(iunout,*) "UPDATE TOTAL GRID FLUXES, FLXFAC", FLXFAC     
      CELL_FLUXES_SUM=CELL_FLUXES_SUM+FLXFAC*CELL_FLUXES
      CELL_FLUXES=0._DP
      FLUXCL_SUM=FLUXCL_SUM+FLXFAC*FLUXCL
      FLUXCL=0._DP

      IF(TRCMOD) THEN
        DO I=1,NFRSPC
          FSUM=0._DP
          DO J=1,NFRCLL
            FSUM=FSUM+SUM(CELL_FLUXES_SUM(:,J,I))
          END DO
          WRITE(iunout,*) "ISPZ,CELL_FLUXES_SUM", I, FSUM
        END DO   
      END IF   

      RETURN

      ENTRY EIRENE_INIT_SUM_FLUX()

      IF(NOFLUXUPDT) RETURN

      CELL_FLUXES_SUM=0._DP
      CELL_FLUXES=0._DP
      FLUXCL_SUM=0._DP
      FLUXCL=0._DP

      END SUBROUTINE EIRENE_SUM_FLUX
      

      SUBROUTINE EIRENE_INIT_RESCALING(SS,ISPZ)
      REAL(DP),INTENT(IN) :: SS(:)
      INTEGER,INTENT(IN) :: ISPZ         
      INTEGER :: I,J         
  
      IF(NOFLUXUPDT) RETURN

      WRITE(iunout,*) "INITIALISATION OF FLUX RESCALING"

      ALPHAKK(ISPZ,:)=1._DP

c       WRITE(iunout,*) "DBG: FLUXES, ISPZ", ISPZ

       DO J=1,MIN(NSBOX,NFRCLL)
        NET_SINK(J,ISPZ)=SS(J)
c        WRITE(iunout,*) "DBG: J,SS,CELL_FLUXES_SUM",
c     w                   J,SS(ISPZ,J)*VOL(J),CELL_FLUXES_SUM(:,J,ISPZ)
        DO I=1,NEMAX+1
          NET_SINK(J,ISPZ)=NET_SINK(J,ISPZ)+
     +                     CELL_FLUXES_SUM(I,J,ISPZ)
        END DO
       END DO

      END SUBROUTINE EIRENE_INIT_RESCALING


      SUBROUTINE EIRENE_FLUX_RESCALING(RR,ISPZ,RESID)
      REAL(DP),INTENT(IN) :: RR(:)
      INTEGER,INTENT(IN) :: ISPZ
      REAL(DP),INTENT(OUT) :: RESID
      REAL(DP) :: RESS,DDRESID, ALPHAKK0,W1
C NOW ZEIDEL ITERATION IS USED BECAUSE I HAVE NOT MANAGED TO FIND SUITABLE W
      REAL(DP),PARAMETER :: W=1.0_DP !UNDERRELAXATION FACTOR      
      INTEGER :: IT,I,J,NN    

      IF(NOFLUXUPDT) RETURN

       RESID=0._DP
       NN=MIN(NSBOX,NFRCLL)
       W1=1._DP-W
       DO I=1,NN
        IF(NET_SINK(I,ISPZ).GT.EPS60) THEN
          ALPHAKK0=ALPHAKK(ISPZ,I)
          ALPHAKK(ISPZ,I)=RR(I)
          DO IT=1,NEMAX
            J=BCELLS(IT,I)
            IF(J.GT.0)
     f       ALPHAKK(ISPZ,I)=ALPHAKK(ISPZ,I)+
     +       CELL_FLUXES_SUM(BSIDES(IT,I),J,ISPZ)*ALPHAKK(ISPZ,J)
          END DO
          DDRESID=NET_SINK(I,ISPZ)*ALPHAKK0
          RESS= ALPHAKK(ISPZ,I)-DDRESID
          IF(DDRESID.GT.EPS60) THEN
           RESS=ABS(RESS/DDRESID)
          ELSE IF(RESS.GT.EPS60) THEN
           IF(TRCMOD)           
     f      WRITE(iunout,*) "WARNING FROM FLUX_RESCALING ",
     w                "DDRESID,RESS ", DDRESID,RESS
          END IF
          IF(RESS.GT.RESID) RESID=RESS
           ALPHAKK(ISPZ,I)=ALPHAKK0*W1+
     +                     ALPHAKK(ISPZ,I)/NET_SINK(I,ISPZ)*W
          IF(ALPHAKK(ISPZ,I).LT.0._DP) THEN
           IF(TRCMOD) 
     f        WRITE(iunout,*) "WARNING FROM FLUX_RESCALING ",
     w                   "NEGATIVE FACTOR, CELL, ALPHA ",
     w                    I,ALPHAKK(ISPZ,I)
           ALPHAKK(ISPZ,I)=1._DP
          END IF 

        END IF
       END DO

      END SUBROUTINE EIRENE_FLUX_RESCALING 

      SUBROUTINE EIRENE_SCALE_FLUXES(ISPZ)

      INTEGER,INTENT(IN) :: ISPZ
      INTEGER :: I

      IF(NOFLUXUPDT) RETURN

       DO I=1,NEMAX+1 
        CELL_FLUXES_SUM(I,:,ISPZ)=CELL_FLUXES_SUM(I,:,ISPZ)*
     *                            ALPHAKK(ISPZ,:)
       END DO

      END SUBROUTINE EIRENE_SCALE_FLUXES

      SUBROUTINE EIRENE_FLUX_RESIDUALS(RR,ISPZ,RESSUM,RESMAX,RESMIN)
      REAL(DP),INTENT(IN) :: RR(:)
      INTEGER,INTENT(IN) :: ISPZ
      REAL(DP),INTENT(OUT) :: RESSUM,RESMAX,RESMIN
      INTEGER IT,I,J
      REAL(DP) :: RES,RESN    
  
      RESSUM=0._DP
      RESMIN=1.0E60_DP
      RESMAX=0._DP
      DO I=1,MIN(NSBOX,NFRCLL)
        RES=RR(I)*VOL(I)
        DO IT=1,NEMAX
          J=BCELLS(IT,I)
          IF(J.GT.0) 
     f      RES=RES+CELL_FLUXES_SUM(BSIDES(IT,I),J,ISPZ)*ALPHAKK(ISPZ,J)
        END DO
c        WRITE(iunout,*) "DBG: I, RES, NET_SINK, ALPHAKK",
c     w                   I, RES, NET_SINK(I,ISPZ)*ALPHAKK(ISPZ,I),
c     w                   ALPHAKK(ISPZ,I)
        RESN=NET_SINK(I,ISPZ)*ALPHAKK(ISPZ,I)
        RESSUM=RESSUM+RES-RESN
        IF(ABS(RESN).GT.EPS60) THEN
          RESN=ABS(RES/RESN-1._DP)
        ELSE
          RESN=0._DP
        END IF
        IF(RESN.GT.RESMAX) RESMAX=RESN
        IF(RESN.LT.RESMIN) RESMIN=RESN
      END DO
          
      RESSUM=ABS(RESSUM/(SUM(NET_SINK(:,ISPZ)*ALPHAKK(ISPZ,:))+EPS60))
      
      END SUBROUTINE EIRENE_FLUX_RESIDUALS 

      END MODULE EIRMOD_CCFLUX
