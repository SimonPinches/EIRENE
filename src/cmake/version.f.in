C> \brief Print EIRENEs git version hash.
C>
C> Prints/sends the date, branch and version hash of EIRENE to the
C> usual output unit.
      SUBROUTINE EIRENE_VERSION
      USE EIRMOD_PARMMOD, ONLY: EIRENE_VERSION_STRING
      USE EIRMOD_COMPRT, ONLY: IUNOUT
      IMPLICIT NONE
      EXTERNAL :: EIRENE_HEADNG, EIRENE_LEER
#ifdef B25_Eirene
#     include <git_version_Eirene.h>
#endif

      WRITE(IUNOUT,'(2A)') ' EIRENE VERSION ',EIRENE_VERSION_STRING
      CALL EIRENE_LEER(2)

      CALL EIRENE_HEADNG('GIT REVISION USED IN THIS RUN',29)

#ifdef B25_Eirene
      WRITE(IUNOUT,*) 'HASH:   ', git_version_Eirene
#else
      WRITE(IUNOUT,*) 'DATE:   ', 
     . '@git_date@'
      WRITE(IUNOUT,*) 'HASH:   ', 
     . '@git_hash@'
      WRITE(IUNOUT,*) 'BRANCH:',
     . '@git_branch@'
#endif

      END SUBROUTINE EIRENE_VERSION

      function get_Eir_hash()
      implicit none
#ifdef B25_Eirene
      character*32 get_Eir_hash
#     include <git_version_Eirene.h>

      get_Eir_hash = git_version_Eirene
#else
      character*31 get_Eir_hash

      get_Eir_hash = '@git_hash@'
#endif

      return
      end function get_Eir_hash
