*//GEOMD//
C=======================================================================
C          S U B R O U T I N E   G E O M D
C=======================================================================
      SUBROUTINE GEOMD(NDXA,NDYA,XPLG,YPLG,NNCUT,NPLP,NPNT,NR1ST,
     .                 PUX,PUY,PVX,PVY)
      IMPLICIT DOUBLE PRECISION (A-H,O-Z)
#include <PARMMOD.F>
      DIMENSION XPLG(N1ST,*),YPLG(N1ST,*),NPNT(2,*),
     .          PUX(*),PUY(*),PVX(*),PVY(*)
C
C  GEOMETRY DATA: CELL VERTICES (LINDA ---> EIRENE)
      COMMON /LINEIR/
     R  X1(NDX),Y1(NDX),X2(NDX),Y2(NDX),X3(NDX),Y3(NDX),
     R  X4(NDX),Y4(NDX)
C
C   DIMENSIONIERUNG FUER GITTER
      INTEGER DIMXH,DIMYH,NNCUT,NNISO,NWISO,
     1 NXCUT1(0:DEF_NCUT),NXCUT2(0:DEF_NCUT),
     . NYCUT1(0:DEF_NCUT),NYCUT2(0:DEF_NCUT),
     2 NXISO1(0:DEF_NCUT),NXISO2(0:DEF_NCUT),
     . NYISO1(0:DEF_NCUT),NYISO2(0:DEF_NCUT)

      DIMENSION DUMMI(3)
C  ACTUAL MESH USED IN THIS RUN
C
C      EINLESEROUTINE ANGEPASST AUF BRAAMS-OUTPUT
C   GEAENDERTE DIMENSIONIERUNG BZW. CUT-POSITION
C        MUSS PER HAND ANGEPASST WERDEN:
C        PARAMETER DIMXH,DIMYH                        RFS 14.5.1991
      DO 1 I=0,DEF_NCUT
         NXCUT1(I)=0
         NXCUT2(I)=0
         NYCUT1(I)=0
         NYCUT2(I)=0
         NXISO1(I)=0
         NXISO2(I)=0
         NYISO1(I)=0
         NYISO2(I)=0
1     CONTINUE
      REWIND 30
      READ (30,3366)
3366  FORMAT(/)
      read(30,*) dimxh,dimyh,nncut
      if(nncut.gt.DEF_NCUT) then
        write(*,*) 'Increase dimension of DEF_NCUT'
        call grexit
      endif
      if(nncut.ge.1) then
        read(30,*) (nxcut1(i),nxcut2(i),nycut1(i),nycut2(i),i=1,nncut)
      else
        read(30,*)
      endif
      if(nncut.gt.2) then
         read(30,*) nniso
         if(nniso.gt.DEF_NCUT) then
           write(*,*) 'Increase dimension of DEF_NCUT'
           call grexit
         endif
         read(30,*) (nxiso1(i),nxiso2(i),nyiso1(i),nyiso2(i),i=1,nniso)
      endif
      read(30,*)
C    ANZAHL DER TEILSTUECKE PRO POLYGON
      NPLP = MAX((NNCUT/2)*3,1)
C    COMPUTE WIDTH OF INSULATING CUT FOR DOUBLE NULL
      NWISO=NXISO2(1)-NXISO1(1)
C    READING OF POLYGON DATA
      DO 10 IX = 1, DIMXH
       IF (IX.LE.nxcut1(1)-1) THEN
        DO 12 IY = 1, DIMYH
         IF (IY.LE.dimyh-1) THEN
          READ (30,3333) DUMMI(1),
     .                  DUMMI(2),DUMMI(3),XPLG(IY,IX)
          READ (30,3333) DUMMI(1),
     .                  DUMMI(2),DUMMI(3),YPLG(IY,IX)
         ENDIF
         IF (IY.EQ.dimyh) THEN
          READ (30,3333) DUMMI(1),
     .                   DUMMI(2),XPLG(dimyh+1,IX),XPLG(IY,IX)
          READ (30,3333) DUMMI(1),
     .                   DUMMI(2),YPLG(dimyh+1,IX),YPLG(IY,IX)
         ENDIF
12      CONTINUE
       ELSEIF (IX.EQ.nxcut1(1)) THEN
        DO 14 IY = 1, DIMYH
         IF (IY.LE.dimyh-1) THEN
         READ (30,3333) XPLG(IY,nxcut2(nncut)),DUMMI(1),
     .                  DUMMI(2),XPLG(IY,IX)
         READ (30,3333) YPLG(IY,nxcut2(nncut)),DUMMI(1),
     .                  DUMMI(2),YPLG(IY,IX)
         ENDIF
         IF (IY.EQ.dimyh) THEN
          READ (30,3333) XPLG(IY,nxcut2(nncut)),
     .                   XPLG(dimyh+1,nxcut2(nncut)),
     .                                XPLG(dimyh+1,IX),XPLG(IY,IX)
          READ (30,3333) YPLG(IY,nxcut2(nncut)),
     .                   YPLG(dimyh+1,nxcut2(nncut)),
     .                                YPLG(dimyh+1,IX),YPLG(IY,IX)
         ENDIF
14      CONTINUE
       ELSEIF ((IX.GE.nxcut2(nncut)).AND.(IX.LE.nxcut1(2)-1)) THEN
        DO 16 IY = 1, DIMYH
         IF (IY.LE.dimyh-1) THEN
          READ (30,3333) DUMMI(1),
     .                   DUMMI(2),DUMMI(3),XPLG(IY,IX+1)
          READ (30,3333) DUMMI(1),
     .                   DUMMI(2),DUMMI(3),YPLG(IY,IX+1)
         ENDIF
         IF (IY.EQ.dimyh) THEN
          READ (30,3333) DUMMI(1),DUMMI(2),
     .                   XPLG(dimyh+1,IX+1),XPLG(IY,IX+1)
          READ (30,3333) DUMMI(1),DUMMI(2),
     .                   YPLG(dimyh+1,IX+1),YPLG(IY,IX+1)
         ENDIF
16      CONTINUE
       ELSEIF (IX.EQ.nxcut1(2)) THEN
        DO 18 IY = 1, DIMYH
         IF (IY.LE.dimyh-1) THEN
         READ (30,3333) XPLG(IY,IX+2),DUMMI(1),
     .                  DUMMI(2),XPLG(IY,IX+1)
         READ (30,3333) YPLG(IY,IX+2),DUMMI(1),
     .                  DUMMI(2),YPLG(IY,IX+1)
         ENDIF
         IF (IY.EQ.dimyh) THEN
          READ (30,3333) XPLG(IY,IX+2),XPLG(dimyh+1,IX+2),
     .                   XPLG(dimyh+1,IX+1),XPLG(IY,IX+1)
          READ (30,3333) YPLG(IY,IX+2),YPLG(dimyh+1,IX+2),
     .                   YPLG(dimyh+1,IX+1),YPLG(IY,IX+1)
         ENDIF
18      CONTINUE
       ELSEIF ((IX.GE.nxcut2(3)).AND.(IX.LE.nxiso1(1)-1)) THEN
        DO 26 IY = 1, DIMYH
         IF (IY.LE.dimyh-1) THEN
          READ (30,3333) DUMMI(1),
     .                   DUMMI(2),DUMMI(3),XPLG(IY,IX+2)
          READ (30,3333) DUMMI(1),
     .                   DUMMI(2),DUMMI(3),YPLG(IY,IX+2)
         ENDIF
         IF (IY.EQ.dimyh) THEN
          READ (30,3333) DUMMI(1),DUMMI(2),XPLG(dimyh+1,IX+2),
     .                   XPLG(IY,IX+2)
          READ (30,3333) DUMMI(1),DUMMI(2),YPLG(dimyh+1,IX+2),
     .                   YPLG(IY,IX+2)
         ENDIF
26      CONTINUE
       ELSEIF (IX.EQ.nxiso1(1)) THEN
        DO 36 IY = 1, DIMYH
         IF (IY.LE.dimyh-1) THEN
          READ (30,3333) XPLG(IY,IX+3),DUMMI(1),
     .                   DUMMI(2),XPLG(IY,IX+2)
          READ (30,3333) YPLG(IY,IX+3),DUMMI(1),
     .                   DUMMI(2),YPLG(IY,IX+2)
         ENDIF
         IF (IY.EQ.dimyh) THEN
          READ (30,3333) XPLG(IY,IX+3),XPLG(IY+1,IX+3),
     .                   XPLG(IY+1,IX+2),XPLG(IY,IX+2)
          READ (30,3333) YPLG(IY,IX+3),YPLG(IY+1,IX+3),
     .                   YPLG(IY+1,IX+2),YPLG(IY,IX+2)
         ENDIF
36      CONTINUE
       ELSEIF ((IX.GE.nxiso2(1)+1).AND.(IX.LE.nxcut1(3)-1)) THEN
        DO 38 IY = 1, DIMYH
         IF (IY.LE.dimyh-1) THEN
          READ (30,3333) DUMMI(1),
     .                   DUMMI(2),DUMMI(3),XPLG(IY,IX+3-NWISO)
          READ (30,3333) DUMMI(1),
     .                   DUMMI(2),DUMMI(3),YPLG(IY,IX+3-NWISO)
         ENDIF
         IF (IY.EQ.dimyh) THEN
          READ (30,3333) DUMMI(1),DUMMI(2),XPLG(dimyh+1,IX+3-NWISO),
     .                   XPLG(IY,IX+3-NWISO)
          READ (30,3333) DUMMI(1),DUMMI(2),YPLG(dimyh+1,IX+3-NWISO),
     .                   YPLG(IY,IX+3-NWISO)
         ENDIF
38      CONTINUE
       ELSEIF (IX.EQ.nxcut1(3)) THEN
        DO 28 IY = 1, DIMYH
         IF (IY.LE.dimyh-1) THEN
          READ (30,3333) XPLG(IY,IX+4-NWISO),DUMMI(1),
     .                   DUMMI(2),XPLG(IY,IX+3-NWISO)
          READ (30,3333) YPLG(IY,IX+4-NWISO),DUMMI(1),
     .                   DUMMI(2),YPLG(IY,IX+3-NWISO)
         ENDIF
         IF (IY.EQ.dimyh) THEN
          READ (30,3333) XPLG(IY,IX+4-NWISO),XPLG(dimyh+1,IX+4-NWISO),
     .                   XPLG(dimyh+1,IX+3-NWISO),XPLG(IY,IX+3-NWISO)
          READ (30,3333) YPLG(IY,IX+4-NWISO),YPLG(dimyh+1,IX+4-NWISO),
     .                   YPLG(dimyh+1,IX+3-NWISO),YPLG(IY,IX+3-NWISO)
         ENDIF
28      CONTINUE
       ELSEIF ((IX.GE.nxcut2(2)).AND.(IX.LE.nxcut1(4)-1)) THEN
        DO 32 IY = 1, DIMYH
         IF (IY.LE.dimyh-1) THEN
          READ (30,3333) DUMMI(1),DUMMI(2),DUMMI(3),
     .                   XPLG(IY,IX+4-NWISO)
          READ (30,3333) DUMMI(1),DUMMI(2),DUMMI(3),
     .                   YPLG(IY,IX+4-NWISO)
         ENDIF
         IF (IY.EQ.dimyh) THEN
          READ (30,3333) DUMMI(1),DUMMI(2),
     .                   XPLG(dimyh+1,IX+4-NWISO),XPLG(IY,IX+4-NWISO)
          READ (30,3333) DUMMI(1),DUMMI(2),
     .                   YPLG(dimyh+1,IX+4-NWISO),YPLG(IY,IX+4-NWISO)
         ENDIF
32      CONTINUE
       ELSEIF (IX.EQ.nxcut1(4)) THEN
        DO 34 IY = 1, DIMYH
         IF (IY.LE.dimyh-1) THEN
          READ (30,3333) XPLG(IY,IX+5-NWISO),DUMMI(1),
     .                   DUMMI(2),XPLG(IY,IX+4-NWISO)
          READ (30,3333) YPLG(IY,IX+5-NWISO),DUMMI(1),
     .                   DUMMI(2),YPLG(IY,IX+4-NWISO)
         ENDIF
         IF (IY.EQ.dimyh) THEN
          READ (30,3333) XPLG(IY,IX+5-NWISO),XPLG(dimyh+1,IX+5-NWISO),
     .                   XPLG(dimyh+1,IX+4-NWISO),XPLG(IY,IX+4-NWISO)
          READ (30,3333) YPLG(IY,IX+5-NWISO),YPLG(dimyh+1,IX+5-NWISO),
     .                   YPLG(dimyh+1,IX+4-NWISO),YPLG(IY,IX+4-NWISO)
         ENDIF
34      CONTINUE
       ELSEIF ((IX.GE.nxcut2(1)).AND.(IX.LE.dimxh-1)) THEN
        DO 22 IY = 1, DIMYH
         IF (IY.LE.dimyh-1) THEN
          READ (30,3333) DUMMI(1),DUMMI(2),DUMMI(3),
     .                   XPLG(IY,IX+NPLP-1-NWISO)
          READ (30,3333) DUMMI(1),DUMMI(2),DUMMI(3),
     .                   YPLG(IY,IX+NPLP-1-NWISO)
         ENDIF
         IF (IY.EQ.dimyh) THEN
          READ (30,3333) DUMMI(1),DUMMI(2),
     .                   XPLG(dimyh+1,IX+NPLP-1-NWISO),
     .                   XPLG(IY,IX+NPLP-1-NWISO)
          READ (30,3333) DUMMI(1),DUMMI(2),
     .                   YPLG(dimyh+1,IX+NPLP-1-NWISO),
     .                   YPLG(IY,IX+NPLP-1-NWISO)
         ENDIF
22      CONTINUE
       ELSEIF (IX.EQ.dimxh) THEN
        DO 24 IY = 1, DIMYH
         IF (IY.LE.dimyh-1) THEN
         READ (30,3333) XPLG(IY,dimxh+NPLP-NWISO),DUMMI(1),DUMMI(2),
     .                  XPLG(IY,IX+NPLP-1-NWISO)
         READ (30,3333) YPLG(IY,dimxh+NPLP-NWISO),DUMMI(1),DUMMI(2),
     .                  YPLG(IY,IX+NPLP-1-NWISO)
         ENDIF
         IF (IY.EQ.dimyh) THEN
          READ (30,3333) XPLG(IY,dimxh+NPLP-NWISO),
     .                   XPLG(dimyh+1,dimxh+NPLP-NWISO),
     .                   XPLG(dimyh+1,IX+NPLP-1-NWISO),
     .                   XPLG(IY,IX+NPLP-1-NWISO)
          READ (30,3333) YPLG(IY,dimxh+NPLP-NWISO),
     .                   YPLG(dimyh+1,dimxh+NPLP-NWISO),
     .                   YPLG(dimyh+1,IX+NPLP-1-NWISO),
     .                   YPLG(IY,IX+NPLP-1-NWISO)
         ENDIF
24      CONTINUE
       ENDIF
10    CONTINUE

3333  FORMAT(4E15.7)

C   ANFANGSPUNKT DES ERSTEN TEILSTUECKS DES I-TEN POLYGONS
      NPNT(1,1)=1
C   ENDPUNKT DES ERSTEN TEILSTUECKS DES I-TEN POLYGONS
      IF (NNCUT.LE.1) THEN
        NPNT(2,1)=dimxh+1
      ELSE
        NPNT(2,1)=nxcut1(1)+1
C   ANFANGSPUNKT DES ZWEITEN TEILSTUECKS DES I-TEN POLYGONS
        NPNT(1,2)=nxcut2(nncut)+1
C   ENDPUNKT DES ZWEITEN TEILSTUECKS DES I-TEN POLYGONS
        NPNT(2,2)=nxcut2(nncut-1)+1
C   ANFANGSPUNKT DES DRITTEN TEILSTUECKS DES I-TEN POLYGONS
        NPNT(1,3)=nxcut2(nncut-1)+2
C   ENDPUNKT DES DRITTEN TEILSTUECKS DES I-TEN POLYGONS
        IF (NNCUT.EQ.2) NPNT(2,3)=dimxh+3
        IF (NNCUT.EQ.4) NPNT(2,3)=NXISO1(1)+3
C   ANFANGSPUNKT DES VIERTEN TEILSTUECKS DES I-TEN POLYGONS
        NPNT(1,4)=nxiso2(1)+4-NWISO
C   ENDPUNKT DES VIERTEN TEILSTUECKS DES I-TEN POLYGONS
        NPNT(2,4)=nxcut1(3)+4-NWISO
C   ANFANGSPUNKT DES FUNFTEN TEILSTUECKS DES I-TEN POLYGONS
        NPNT(1,5)=nxcut2(2)+4-NWISO
C   ENDPUNKT DES FUNFTEN TEILSTUECKS DES I-TEN POLYGONS
        NPNT(2,5)=nxcut1(4)+5-NWISO
C   ANFANGSPUNKT DES SECHSTEN TEILSTUECKS DES I-TEN POLYGONS
        NPNT(1,6)=nxcut2(1)+5-NWISO
C   ENDPUNKT DES SECHSTEN TEILSTUECKS DES I-TEN POLYGONS
        NPNT(2,6)=dimxh+6-NWISO
      ENDIF
      DO 1015 IY=1,NDYA
        DO 1014 IX=1,NDXA
          X1(IX)=XPLG(IY,IX)
          Y1(IX)=YPLG(IY,IX)
          X2(IX)=XPLG(IY,IX+1)
          Y2(IX)=YPLG(IY,IX+1)
          X3(IX)=XPLG(IY+1,IX)
          Y3(IX)=YPLG(IY+1,IX)
          X4(IX)=XPLG(IY+1,IX+1)
          Y4(IX)=YPLG(IY+1,IX+1)
1014    CONTINUE
        CALL MSHPROJ (X1,Y1,X2,Y2,X3,Y3,X4,Y4,PUX,PUY,PVX,PVY,NDXA,
     .                NR1ST,IY)
1015  CONTINUE
C
      NP=NPNT(2,NPLP)
      DO 1020 J=1,NDYA+1
        DO 1020 I=1,NP
          XPLG(J,I)=XPLG(J,I)*100.
          YPLG(J,I)=YPLG(J,I)*100.
          IF (ABS(XPLG(J,I)).LT.5.E-5) XPLG(J,I)=0.
          IF (ABS(YPLG(J,I)).LT.5.E-5) YPLG(J,I)=0.
1020  CONTINUE
      RETURN
*//END GEOMD//
      END
