C
C
C
      SUBROUTINE EIRENE_GEOUSR
c
c  version : 12.03.98 21:02
c
c======================================================================
C***  PREPARE DATA FOR ADDITIONAL SURFACES
c======================================================================
      USE EIRMOD_PRECISION
      use EIRMOD_PARMMOD
      use EIRMOD_CADGEO
      use EIRMOD_CTRCEI
      use EIRMOD_CCONA
      use EIRMOD_CGEOM
      use EIRMOD_CGRID
      use EIRMOD_CLGIN
      use EIRMOD_CPOLYG
      use EIRMOD_CINIT
      use EIRMOD_COMPRT
      use EIRMOD_CLOGAU

      IMPLICIT NONE

      logical ::first, normalcase, hlp_found
      integer ::onetwo(8),limpos(8),xpolpos(8),ypolpos(8)
      character(80) :: geometry_comment
      REAL(DP), PARAMETER :: hlp_tol=0.001

      save first,onetwo,limpos,geometry_comment
      data first /.true./
c======================================================================
c*** At the first invocation, read the data from the Eirene input file
c*** and define the grid corners
c
      IF (NLPLG) THEN
      if(.not.first) return    ! dpc 2002.03.15 (XPB+DR)
        read(iunin,'(a80)') geometry_comment
        do i=1,8
          onetwo(i)=0
          limpos(i)=0
        end do
C INNER LEFT TARGET
        xpolpos(1)=1
        ypolpos(1)=npoint(1,1)
        xpolpos(2)=nr1st
        ypolpos(2)=npoint(1,1)
C OUTER RIGHT TARGET
        if(npplg.le.3) then
          xpolpos(3)=1
          ypolpos(3)=npoint(2,npplg)
        else if(npplg.eq.6) then
          xpolpos(3)=1
          ypolpos(3)=npoint(2,3)-1
        end if
        if(npplg.le.3) then
          xpolpos(4)=nr1st
          ypolpos(4)=npoint(2,npplg)
        else if(npplg.eq.6) then
          xpolpos(4)=nr1st
          ypolpos(4)=npoint(2,3)-1
        end if

        if(npplg.eq.6) then
C OUTER LEFT TARGET
        xpolpos(5)=1
        ypolpos(5)=npoint(1,4)+1
        xpolpos(6)=nr1st
        ypolpos(6)=npoint(1,4)+1
C INNER RIGHT TARGET
        xpolpos(7)=1
        ypolpos(7)=npoint(2,6)
        xpolpos(8)=nr1st
        ypolpos(8)=npoint(2,6)
        end if

        normalcase=.true.
	if(npplg.eq.1) then             ! limiter case
	  numpairs=1
          if(nncut.eq.0) then           ! linear case with cylindrical symmetry
            if(xpol(1,1).lt.xpol(nr1st,1)) then  ! we find the outer side
              xpolpos(1)=nr1st
              xpolpos(2)=nr1st
            else
              xpolpos(1)=1
              xpolpos(2)=1
            endif
            ypolpos(1)=npoint(1,1)
            ypolpos(2)=npoint(2,1)
          elseif(nncut.eq.1) then       ! limiter case
	    xpolpos(1)=nr1st
	    ypolpos(1)=npoint(1,1)
	    xpolpos(2)=nr1st
	    ypolpos(2)=npoint(2,1)
	  else
	    write(*,*) 'The case for npplg = ',npplg,
     1	     ' and nncut =',nncut,' has not (yet) been coded'
	    call grexit
          endif
	elseif(npplg.eq.3) then         ! single null
	  numpairs=2
	elseif(npplg.eq.6) then         ! double null
	  numpairs=4
	else
	  write(*,*) 'The case for npplg = ',npplg,
     1	   ' has not (yet) been coded'
	  call grexit
	endif

        do i=1,numpairs*2
          read(iunin,*) onetwo(i),limpos(i)
          if(onetwo(i).lt.0) then
            normalcase=.false.
            onetwo(i)=-onetwo(i)
            read(iunin,*) xpolpos(i),ypolpos(i)
          end if
        end do
        first=.false.
!        write(iunout,*) 'GEOMETRY FOR'
!        write(iunout,'(a80)') geometry_comment

	if(onetwo(1).eq.0) then
            write(iunout,*) 'Geometry fixup skipped'
	  goto 1001
	end if
 	if (npplg.eq.1) then
	  write(*,
     1	   '(''P'',i1,'' FOR SEG '',i3,'' --> LEFT TARG'')') 
     2	   onetwo(1),limpos(1)
	  write(*,
     1	   '(''P'',i1,'' FOR SEG '',i3,'' --> RIGHT TARG'')') 
     2	   onetwo(2),limpos(2)
	else if (npplg.eq.3) then
          write(iunout,'(''P'',i1,'' FOR SEGMENT '',i3,
     1     '' LINKED TO INNER LEFT TARGET'')') onetwo(1),limpos(1)
          write(iunout,'(''P'',i1,'' FOR SEGMENT '',i3,
     1     '' LINKED TO OUTER LEFT TARGET'')') onetwo(2),limpos(2)
          write(iunout,'(''P'',i1,'' FOR SEGMENT '',i3,
     1     '' LINKED TO INNER RIGHT TARGET'')') onetwo(3),limpos(3)
          write(iunout,'(''P'',i1,'' FOR SEGMENT '',i3,
     1     '' LINKED TO OUTER RIGHT TARGET'')') onetwo(4),limpos(4)
        else if (npplg.eq.6) then
          write(iunout,'(''P'',i1,'' FOR SEGMENT '',i3,
     1     '' LINKED TO INNER LEFT TARGET'')') onetwo(1),limpos(1)
          write(iunout,'(''P'',i1,'' FOR SEGMENT '',i3,
     1     '' LINKED TO INNER LEFT TARGET'')') onetwo(2),limpos(2)
          write(iunout,'(''P'',i1,'' FOR SEGMENT '',i3,
     1     '' LINKED TO OUTER RIGHT TARGET'')') onetwo(3),limpos(3)
          write(iunout,'(''P'',i1,'' FOR SEGMENT '',i3,
     1     '' LINKED TO OUTER RIGHT TARGET'')') onetwo(4),limpos(4)
          write(iunout,'(''P'',i1,'' FOR SEGMENT '',i3,
     1     '' LINKED TO OUTER LEFT TARGET'')') onetwo(5),limpos(5)
          write(iunout,'(''P'',i1,'' FOR SEGMENT '',i3,
     1     '' LINKED TO OUTER LEFT TARGET'')') onetwo(6),limpos(6)
          write(iunout,'(''P'',i1,'' FOR SEGMENT '',i3,
     1     '' LINKED TO INNER RIGHT TARGET'')') onetwo(7),limpos(7)
          write(iunout,'(''P'',i1,'' FOR SEGMENT '',i3,
     1     '' LINKED TO INNER RIGHT TARGET'')') onetwo(8),limpos(8)
        else
          write(*,*) 'Case NPPLG = ',NPPLG,' not coded. '
	  call grexit
        end if
c dpc 2002.03.15 (XPB+DR)      end if
c
c*** Switch off the additional surfaces corresponding to the targets,
c*** that is, the surfaces between the ones to be linked to the grid
c*** corners.
c
      n=numpairs*2
c      print '(/(2i8))',(limpos(i),onetwo(i),i=1,n)
      do 990 i=1,n
        if(onetwo(i).eq.2) then
          m=limpos(i)
	  if(rlb(m).ge.2.0) then
	    hlp_p1=p2(1,m)
	    hlp_p2=p2(2,m)
c          print *,'onetwo=2. igjum0= ',igjum0(j),',  i,hlp_p1,hlp_p2 =
c          print *,i,hlp_p1,hlp_p2
	    do 980 l=1,nlimi
	      do j=1,nlimi
		hlp_found=.false.
c              print *,'lgjum0,j,m = ',lgjum0(j),j,m
		if(igjum0(j)==0 .and. j.ne.m .and. iliin(j).eq.1) then
		  if(abs(hlp_p1-p1(1,j)).le.hlp_tol .and.
     .		   abs(hlp_p2-p1(2,j)).le.hlp_tol) then
		    hlp_found=.true.
		    hlp_p1=p2(1,j)
		    hlp_p2=p2(2,j)
		  else if(abs(hlp_p1-p2(1,j)).le.hlp_tol .and.
     .		   abs(hlp_p2-p2(2,j)).le.hlp_tol) then
		    hlp_found=.true.
		    hlp_p1=p1(1,j)
		    hlp_p2=p1(2,j)
		  end if
		  if(hlp_found) then
c                print *,j,hlp_p1,hlp_p2
c*** Check whether this segment is marked as a target edge
		    do k=1,n
		      if(j.eq.limpos(k)) then
			if(onetwo(k).eq.1) then
			  go to 990
			else
			  write(*,*) 'addusr: something is wrong with ',
     ,			   'the target chain definition.'
			  write(*,*) 'Check the data on the target ',
     ,			   'edges at the very end of the Eirene ',
     1			   'input file.'
			  call grexit
			end if
		      end if
		    end do
c*** Switch off the segment
		    igjum0(j)=1
                  print *,'geousr_biased: segment ',j,'  is turned off'
		    go to 980
		  end if
		end if
	      end do
c*** The chain is broken
            print *,'geousr_biased: the chain is broken'
	      go to 990
  980	    continue
	  elseif(rlb(m).gt.0) then
! nothing
          elseif(rlb(m).lt.0) then
! nothing
	  else
	    write(*,*) 'Work needs to be done in addusr for mapping',
     1	     ' the elements'
	    call GREXIT
	  endif
	end if
  990 continue
 1001 continue
C
C  ANFANG: MODIFY GEOMETRY
C
      do i=1,numpairs*2
	m=limpos(i)
	if(rlb(m).ge.2.0) then
	  if(onetwo(i).eq.1) then
	    p1(1,limpos(i))=xpol(xpolpos(i),ypolpos(i))
	    p1(2,limpos(i))=ypol(xpolpos(i),ypolpos(i))
	  elseif(onetwo(i).eq.2) then
	    p2(1,limpos(i))=xpol(xpolpos(i),ypolpos(i))
	    p2(2,limpos(i))=ypol(xpolpos(i),ypolpos(i))
	  endif
	elseif(rlb(m).gt.0) then
c the following is coded specifically for the AUG case
c where the limiter is the second order surface of the heat shield
c which is determined by the y-bounds of a bounding box
	  if(onetwo(i).eq.1) then
	    ylims1(limpos(i),1)=ypol(xpolpos(i),ypolpos(i))
	  elseif(onetwo(i).eq.2) then
	    ylims2(limpos(i),1)=ypol(xpolpos(i),ypolpos(i))
	  end if
        elseif(rlb(m).lt.0) then
c the following is coded specifically for the PLATO case
c meaning a cylindrical plasma hitting plates at both ends
c we adjust the radius limiting the target and source surfaces
c for this we must change the equation from a flat y=y0 plane to
c a cylinder of revolution in case ypos does not match exactly y0 
          y0 = -a0lm(limpos(i))/a2lm(limpos(i))
          rpos = xpol(xpolpos(i),ypolpos(i))
          ypos = ypol(xpolpos(i),ypolpos(i))
          if(onetwo(i).eq.1) then
            r0 = sqrt(alims0(limpos(i),2))
            alims0(limpos(i),1)=-rpos**2
            xlims2(limpos(i),1)= 1.0
            zlims2(limpos(i),1)= 1.0
          elseif(onetwo(i).eq.2) then
            r0 = sqrt(-alims0(limpos(i),1))
            alims0(limpos(i),2)= rpos**2
            xlims2(limpos(i),2)=-1.0
            zlims2(limpos(i),2)=-1.0
          endif
          a0lm(limpos(i)) = (y0*rpos-r0*ypos)**2
          a2lm(limpos(i)) = 2.*(r0-rpos)*(y0*rpos-r0*ypos)
          a4lm(limpos(i)) = -(y0-ypos)**2
          a5lm(limpos(i)) =  (r0-rpos)**2
          a6lm(limpos(i)) = a4lm(limpos(i))
          alims(limpos(i),1) = -ypos*ylims(limpos(i),1)
	else
	  write(*,*) 'Work needs to be done in addusr for mapping',
     1	   ' the elements'
	  call GREXIT
	endif
      end do
c=====================================================
C  ABSCHALTEN NICHT ERREICHBARER ODER DOPPELT VORHANDENER FLAECHEN
C
C   HIERHER: LGJUM1, LGJUM2 SETZEN ZUR BESCHLEUNIGUNG (NICHT UNBEDINGT
C   NOETIG)
C
C   LGJUM1(J,I)=.TRUE. :
C   ABSCHALTEN DER FLAECHE I, FALLS TEILCHEN AUF J SITZT
C
C   LGJUM2(J,I)=.TRUE. :
C   ABSCHALTEN DES ERSTEN SCHNITTPUNKTES MIT FLAECHE I, FALLS
C   TEILCHEN AUF J SITZT (FALLS I EINE FLAECHE ZWEITER ORDNUNG IST)
C
C   DEFAULTS: LGJUM1(J,J)=.TRUE. FUER EBENE FLAECHEN,
C             LGJUM2(J,J)=.TRUE. FUER FLAECHEN ZWEITER ORDNUNG
C
C
C   LGJUM3(J,I)=.TRUE. :
C   ABSCHALTEN DER FLAECHE I, FALLS TEILCHEN IN ZELLE J SITZT
C
      if(normalcase) then
	write(*,*) 'Setting IGJUM3 to 1 for',min(NSURF,NOPTIM),NLIMI
        do I=1,NLIMI
          do J=1,min(NSURF,NOPTIM)
            IGJUM3(J,I)=1    ! dpc was 1 (back again)
          end do
        end do
      else
	write(*,*) 'Setting IGJUM3 to 0 for ',min(NSURF,NOPTIM),NLIMI
        do I=1,NLIMI
          do J=1,min(NSURF,NOPTIM)
            IGJUM3(J,I)=0    ! dpc was 0 (back again)
          end do
        end do
      end if
      END IF
C
C  SET SOME VOLUMES EXPLICITLY
C
C
C  MODIFY REFLECTION MODEL AT TARGET PLATES
C
C
      RETURN
      END
